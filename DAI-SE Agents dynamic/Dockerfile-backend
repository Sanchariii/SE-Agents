FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# ffmpeg for audio/video ingestion; libgl1 + libglib for OpenCV; LibreOffice
# Impress and fonts for max mode's slide renders.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 \
        libreoffice-impress fontconfig fonts-crosextra-carlito fonts-liberation2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY company-ppt-templet/ ./company-ppt-templet/

# Max mode renders slides with headless LibreOffice; without Barlow it would
# substitute a wider font and the visual review would judge the wrong wrapping.
COPY company-ppt-templet/fonts/barlow/ /usr/local/share/fonts/barlow/
RUN fc-cache -f
COPY app ./app

# Install Rockwell certificate
RUN cp /app/app/config/GenAI-api-q.rockwell.pem \
    /usr/local/share/ca-certificates/GenAI-api-q.rockwell.crt \
    && update-ca-certificates

 
# Optional: Ensure Python/Requests uses the cert
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Never run as root.
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

# Hosted mode reads secrets from Azure Key Vault (see app/config/keyvault.py).
ENV APP_TYPE=hosted \
    APP_ENV=prod
EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8002/api/health').read()"

CMD ["uvicorn", "app.core.services.server:app", "--host", "0.0.0.0", "--port", "8002"]
