+"""Skill deck agent: the app's ppt skill + our whole-deck skill + the session's style
+skill in, ONE DeckBuilder program for the whole deck out, run on the official template.
+
+    deck_engine.build_deck   - the entry point the deck workflow calls
+    scorecard.score_deck     - the deck scorecard (also used by the deck polish agent)
+
+See README.md.
+"""
diff --git a/app/genai/skill_deck/deck_engine.py b/app/genai/skill_deck/deck_engine.py
new file mode 100644
index 0000000..d5bae7b
--- /dev/null
+++ b/app/genai/skill_deck/deck_engine.py
@@ -0,0 +1,150 @@
+"""Skill deck agent inside the app: turn the deck the workflow already wrote into a PPT.
+
+The deck workflow keeps doing triage, extraction, planning, approval, slide writing and
+the deck design contract. When ``DECK_ENGINE=skill_deck``, its collect stage calls
+:func:`build_deck` instead of the per-slide designer and stitcher: ONE program designs
+every slide on the official template with DeckBuilder, guided by the app's ppt skill,
+our whole-deck skill and the session's style skill (if any). The result is published as
+a normal deck version, so preview, download, versions and feedback work unchanged.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from app.config.constants import DeckEngines, SkillDeckConstants as C
+from app.config.settings import get_settings
+from app.utilities.logger_util import get_logger
+
+log = get_logger(__name__)
+
+#: SlideDraft fields the program does not need: the layout comes from the design
+#: contract and images are passed as local files (``image_paths``).
+_DROP_FIELDS = {"layout", "image_candidates"}
+
+
+def enabled() -> bool:
+    """True when this deployment builds decks with the skill deck agent.
+
+    Returns:
+        Whether the DECK_ENGINE setting selects the skills engine.
+    """
+    engine = (get_settings().deck_engine or DeckEngines.CLASSIC).strip().lower()
+    if engine not in DeckEngines.ALL:
+        log.warning("unknown DECK_ENGINE %r; using %r", engine, DeckEngines.CLASSIC)
+        return False
+    return engine == DeckEngines.SKILL_DECK
+
+
+def _prune(value):
+    """Drop empty values so the spec sent to the model stays small."""
+    if isinstance(value, dict):
+        out = {k: _prune(v) for k, v in value.items()}
+        return {k: v for k, v in out.items() if v not in ("", [], {}, None)}
+    if isinstance(value, list):
+        return [p for p in (_prune(v) for v in value) if p not in ("", [], {}, None)]
+    return value
+
+
+def deck_spec(draft, plan) -> dict:
+    """The written deck as compact JSON for the model.
+
+    Args:
+        draft: The assembled DeckDraft (slides already renumbered).
+        plan: The DeckPlan, for audience, objective and tone.
+
+    Returns:
+        A dict with deck-level fields and one entry per slide.
+    """
+    slides = []
+    for slide in draft.slides:
+        data = slide.model_dump(mode="json", exclude=_DROP_FIELDS)
+        for block in data.get("blocks") or []:
+            block.pop("image_ref", None)
+        slides.append(_prune(data))
+    return _prune({"title": draft.title, "subtitle": draft.subtitle,
+                   "audience": getattr(plan, "audience", ""),
+                   "objective": getattr(plan, "objective", ""),
+                   "tone": getattr(plan, "tone", ""),
+                   "takeaways": draft.takeaways, "slides": slides})
+
+
+def active_reference_profiles(skill: dict | None, stored: dict) -> list[dict]:
+    """The inspected profiles of the references pinned to the session's active skill.
+
+    Args:
+        skill: ``session_store.get_active_skill(...)`` (None when no skill is active).
+        stored: ``session_store.get_skill_references(...)``.
+
+    Returns:
+        Profiles whose digest still matches the pin; a changed or missing reference is
+        skipped rather than trusted.
+    """
+    profiles = []
+    for reference in (skill or {}).get("references") or []:
+        profile = (stored.get(reference.get("reference_id")) or {}).get("profile")
+        if profile and profile.get("sha256") == reference.get("sha256"):
+            profiles.append(profile)
+    return profiles
+
+
+def build_deck(session_id: str, draft, plan, workdir: Path, classification: str,
+               contract, catalog=None, creativity: str = "MED", style_guidance: str = "",
+               references: list[dict] | None = None, image_paths: dict | None = None,
+               writer=None, on_step=None) -> tuple[Path, list[str]]:
+    """Build the whole deck with the skill deck agent.
+
+    Args:
+        session_id: Owning session, for logs.
+        draft: The assembled DeckDraft.
+        plan: The DeckPlan.
+        workdir: The turn's work directory; the agent runs in a sub-folder of it.
+        classification: Normalised classification (each slide's frame carries it).
+        contract: The deck design contract (``design_contract.build``) - the same
+            master, layouts, frame, grid and tokens the classic engine would use.
+        catalog: The template catalog; loaded when not given.
+        creativity: The deck's creativity level (LOW, MED or HIGH).
+        style_guidance: The session's active style skill ("" when none is active).
+        references: Inspected profiles of that skill's references
+            (:func:`active_reference_profiles`); the deck is checked against them.
+        image_paths: Local image files per slide number.
+        writer: Program writer; defaults to the gateway model (tests pass a fake).
+        on_step: Callback for progress lines shown in the chat.
+
+    Returns:
+        Tuple of (deck path, notes: remaining problems and style differences).
+
+    Raises:
+        RuntimeError: When no deck could be built; the workflow reports it and keeps
+            the turn's content for a retry.
+    """
+    from app.genai.skill_deck import prompts, staging, style_match
+    from app.genai.skill_deck.graph import build_graph
+    from app.genai.skill_deck.llm import GatewayProgramWriter
+
+    if catalog is None:
+        from app.genai.ppt.template import catalog as catalog_mod
+        catalog = catalog_mod.load()
+    spec = deck_spec(draft, plan)
+    slides = staging.slide_specs(draft, contract, catalog, image_paths)
+    run_dir = Path(workdir) / C.RUN_DIRNAME
+    staging.stage(run_dir, catalog, slides, contract)
+    target = style_match.style_target(references or [])
+    if references and not target:
+        log.info("style references carry no slide geometry; style check skipped")
+    system, names = prompts.system_prompt(creativity, style_guidance,
+                                          style_match.describe(target))
+    message = prompts.user_message(spec, slides, catalog, classification, creativity)
+    log.info("skill deck agent: %d slide(s) for session %s, skills %s, creativity %s",
+             len(slides), session_id, names, creativity, extra={"session_id": session_id})
+    if on_step:
+        on_step(f"Skill deck agent: passing skills {', '.join(names)}.")
+    state = build_graph(writer or GatewayProgramWriter(), on_step).invoke({
+        "system": system, "messages": [{"role": "user", "content": message}],
+        "run_dir": str(run_dir), "output_path": str(Path(workdir) / "deck.pptx"),
+        "slide_count": len(slides), "style_target": target, "spec": spec,
+        "attempts": 0, "layout_rounds": 0, "warnings": [], "good_deck": ""})
+    if state.get("status") != "done":
+        raise RuntimeError(f"skill deck agent gave up after {state.get('attempts')} "
+                           f"attempt(s): {state.get('error')}")
+    return Path(state["final_deck"]), list(state.get("warnings") or [])
diff --git a/app/genai/skill_deck/deck_kit.py b/app/genai/skill_deck/deck_kit.py
new file mode 100644
index 0000000..5c02d67
--- /dev/null
+++ b/app/genai/skill_deck/deck_kit.py
@@ -0,0 +1,57 @@
+"""Copied into the run folder beside the model's program - like ``deck_builder.py``,
+it must never import ``app.*`` (the sandbox has no access to it).
+
+``WholeDeck`` is DeckBuilder for a WHOLE deck: ``deck.slide(n)`` puts slide n on the
+layout the deck design contract assigned it, and ``deck.save()`` stamps every slide's
+own frame (classification, slide number, logo variant) and highlights the correct quiz
+choice on answer slides only. DeckBuilder itself has one frame and one reveal switch
+per deck, which is right for the per-slide designer and wrong for a whole deck.
+"""
+from deck_builder import DeckBuilder
+
+import context
+
+
+class WholeDeck(DeckBuilder):
+    """The whole deck on the official template, one assigned layout per slide."""
+
+    def __init__(self):
+        super().__init__(context.TEMPLATE_PATH, context.CATALOG, frame=None,
+                         reveal_answers=False)
+        self._specs = {spec["number"]: spec for spec in context.SLIDES}
+        self._added = []
+
+    def slide(self, number):
+        """Add slide ``number`` on its assigned layout and return its SlideHandle.
+
+        Slides must be added in order (1, 2, 3 ...), each exactly once.
+        """
+        spec = self._specs.get(number)
+        if spec is None:
+            raise KeyError(f"there is no slide {number}; SLIDES has 1 to {len(self._specs)}")
+        expected = len(self._added) + 1
+        if number != expected:
+            raise ValueError(f"add the slides in order: the next one is slide {expected}, "
+                             f"not {number}")
+        handle = self.add_slide(spec["layout_key"])
+        self._added.append((handle, spec))
+        return handle
+
+    def images(self, number):
+        """The image files slide ``number`` may place (absolute paths)."""
+        return list(self._specs[number].get("images") or [])
+
+    def save(self, path=None):
+        """Stamp each slide's own frame, reveal answers where asked, then write."""
+        missing = sorted(set(self._specs) - {spec["number"] for _, spec in self._added})
+        if missing:
+            raise RuntimeError(f"slide(s) {missing} were never added; call deck.slide(n) "
+                               "for every slide in SLIDES")
+        for handle, spec in self._added:
+            if spec.get("reveal"):
+                handle._reveal_choices()
+        for handle, spec in self._added:
+            self.frame = spec.get("frame") or {}
+            handle.finalize()               # idempotent: DeckBuilder.save will not re-stamp
+        self.frame = {}
+        return super().save(path or context.OUTPUT_PATH)
diff --git a/app/genai/skill_deck/graph.py b/app/genai/skill_deck/graph.py
new file mode 100644
index 0000000..1c30fea
--- /dev/null
+++ b/app/genai/skill_deck/graph.py
@@ -0,0 +1,245 @@
+"""The LangGraph agent.
+
+    START -> write_program -> run_program --ok--> check_deck --clean--> finish -> score -> END
+                 ^                |                    |
+                 |             failed           problems (once)
+                 +-- repair <-----+                    |
+                 +-- fix_deck <------------------------+
+                                  |
+                 failed, no attempts left -> fail -> END
+                 (or finish with the best deck so far, if there is one)
+
+The prompt (``prompts.py``) and the run folder (``staging.py``) are prepared before
+the graph starts, by ``deck_engine.build_deck``.
+
+* write_program : the model writes ONE DeckBuilder program for the whole deck.
+* run_program   : the classic code guard checks it, then it runs locally in the run
+                  folder on the official template (no secrets inherited).
+* repair        : the error goes back to the model for a fixed program.
+* check_deck    : DeckBuilder's own warnings, the layout check every engine is scored
+                  by, a slide count check and - when the user picked a reference - the
+                  style match. Every version is kept and the best one is remembered.
+* fix_deck      : once, those problems go back to the model for a fixed program.
+* finish        : the BEST version becomes the deck (a fix round that made it worse is
+                  thrown away). No logos are stamped: the template carries them and
+                  DeckBuilder stamps each slide's frame.
+* score         : the deck scorecard (layout, brand, readability, content, style).
+"""
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+from typing import Callable, TypedDict
+
+from app.config.constants import SkillDeckConstants as C
+from app.genai.skill_deck import layout_check, sandbox, scorecard, style_match
+from app.genai.skill_deck.llm import NoProgramError, ProgramWriter
+from app.utilities import run_control
+from app.utilities.logger_util import get_logger
+
+log = get_logger(__name__)
+
+
+class DeckState(TypedDict, total=False):
+    """Everything the nodes read and write."""
+    system: str                # system prompt with the skills
+    messages: list[dict]       # conversation with the model
+    run_dir: str               # staged run folder
+    output_path: str           # where the final deck is saved
+    slide_count: int           # slides the program must build
+    program: str               # latest generated program
+    attempts: int              # programs requested so far
+    error: str                 # latest failure, fed back on repair
+    raw_deck: str              # deck the latest program wrote
+    good_deck: str             # best deck so far (fallback when a fix round fails)
+    best: dict                 # {"deck", "problems", "style_score", "differences"}
+    layout_problems: list[str] # what check_deck found in raw_deck
+    style_target: dict         # measures from the reference ({} = no reference)
+    style_score: int           # style match of raw_deck, 0-100
+    style_differences: list[str]
+    layout_rounds: int         # fix rounds done so far
+    spec: dict                 # the written deck, for the content score
+    scorecard: dict            # final deck's scorecard
+    final_deck: str
+    warnings: list[str]
+    status: str                # "done" or "failed"
+
+
+def _rank(version: dict) -> tuple[int, int]:
+    """Lower is better: fewer problems first, then a closer style match."""
+    return len(version.get("problems") or []), -(version.get("style_score") or 0)
+
+
+def _problems(deck: Path, run_dir: Path, slide_count: int) -> list[str]:
+    from pptx import Presentation
+    problems = []
+    built = len(Presentation(str(deck)).slides)
+    if built != slide_count:
+        problems.append(f"the deck has {built} slide(s) but SLIDES has {slide_count}")
+    problems += [f"DeckBuilder: {w}" for w in sandbox.builder_warnings(run_dir)]
+    problems += layout_check.layout_problems(deck, universal=True)
+    return problems[:C.LAYOUT_MAX_PROBLEMS]
+
+
+def build_graph(writer: ProgramWriter, on_step: Callable[[str], None] | None = None):
+    """Compile the agent.
+
+    Args:
+        writer: Turns prompts into programs (the gateway model, or a fake in tests).
+        on_step: Optional callback for short progress lines (the app shows them in
+            the chat as the run's steps).
+
+    Returns:
+        A compiled LangGraph app; call ``.invoke(state)``.
+    """
+    from langgraph.graph import END, START, StateGraph
+
+    def step(message: str) -> None:
+        if on_step:
+            on_step(message)
+
+    def write_program(state: DeckState) -> DeckState:
+        attempts = state.get("attempts", 0) + 1
+        run_control.checkpoint()
+        step(f"Skill deck agent: writing the deck program (attempt {attempts}).")
+        try:
+            program = writer.write_program(state["system"], state["messages"])
+            return {"program": program, "attempts": attempts, "error": ""}
+        except NoProgramError as exc:
+            return {"program": "", "attempts": attempts, "error": str(exc)}
+
+    def run_program(state: DeckState) -> DeckState:
+        if not state.get("program"):
+            return {"raw_deck": "", "error": state.get("error") or "no program"}
+        run_control.checkpoint()
+        ok, error, deck = sandbox.run_program(state["program"], Path(state["run_dir"]))
+        step("Skill deck agent: the program built the deck on the official template."
+             if ok else "Skill deck agent: the program failed; asking for a fix.")
+        log.info("attempt %d: program %s", state["attempts"], "ran" if ok else "failed")
+        return {"raw_deck": str(deck) if ok else "", "error": error}
+
+    def after_run(state: DeckState) -> str:
+        if state.get("raw_deck"):
+            return "check_deck"
+        if state.get("attempts", 0) < C.MAX_FIX_ATTEMPTS:
+            return "repair"
+        return "finish" if state.get("good_deck") else "fail"
+
+    def check_deck(state: DeckState) -> DeckState:
+        raw = Path(state["raw_deck"])
+        rounds = state.get("layout_rounds", 0)
+        kept = raw.with_name(f"{raw.stem}_v{rounds + 1}{raw.suffix}")
+        shutil.copyfile(raw, kept)          # the next program saves over raw_deck
+        try:
+            problems = _problems(raw, Path(state["run_dir"]), state["slide_count"])
+        except Exception as exc:            # a check bug must never cost the deck
+            log.warning("deck check failed: %s", exc)
+            problems = []
+        step(f"Deck check: {len(problems)} problem(s) found." if problems
+             else "Deck check: no problems found.")
+        match, differences = None, []
+        if state.get("style_target"):
+            try:
+                match, differences = style_match.compare(
+                    state["style_target"], style_match.deck_style(raw))
+                step(f"Style check: {match}% match with the reference"
+                     + (f"; {len(differences)} difference(s)." if differences else "."))
+            except Exception as exc:        # same rule as the deck check
+                log.warning("style check failed: %s", exc)
+        version = {"deck": str(kept), "problems": problems, "style_score": match,
+                   "differences": differences}
+        best = state.get("best")
+        if best and _rank(best) < _rank(version):
+            step("Kept the earlier version of the deck: the fix round made it worse.")
+        else:
+            best = version
+        return {"good_deck": best["deck"], "best": best, "layout_problems": problems,
+                "style_score": match, "style_differences": differences}
+
+    def after_check(state: DeckState) -> str:
+        wrong = state.get("layout_problems") or state.get("style_differences")
+        if wrong and state.get("layout_rounds", 0) < C.MAX_LAYOUT_FIXES:
+            return "fix_deck"
+        return "finish"
+
+    def fix_deck(state: DeckState) -> DeckState:
+        problems = state.get("layout_problems") or []
+        differences = state.get("style_differences") or []
+        goals = (["fix the deck"] if problems else []) + (
+            ["match the reference style"] if differences else [])
+        step(f"Skill deck agent: asking the model to {' and '.join(goals)}.")
+        sections = []
+        if problems:
+            sections.append("=== PROBLEMS ===\n" + "\n".join(f"- {p}" for p in problems))
+        if differences:
+            sections.append(
+                "=== STYLE DIFFERENCES (from the reference the user picked) ===\n"
+                + "\n".join(f"- {d}" for d in differences)
+                + "\nMatch the reference where you can; the Rockwell ppt skill always wins.")
+        messages = list(state["messages"])
+        messages.append({"role": "assistant",
+                         "content": f"```python\n{state['program']}\n```"})
+        messages.append({"role": "user", "content": (
+            "Your program ran, but the deck needs these fixes. Return the complete fixed "
+            "program with the same content: move, resize or shorten only what is needed "
+            "(detail goes into the speaker notes) and keep every slide on its assigned "
+            "layout. It must still end with deck.save(OUTPUT_PATH).\n\n"
+            + "\n\n".join(sections))})
+        return {"messages": messages, "layout_rounds": state.get("layout_rounds", 0) + 1}
+
+    def repair(state: DeckState) -> DeckState:
+        messages = list(state["messages"])
+        if state.get("program"):
+            messages.append({"role": "assistant",
+                             "content": f"```python\n{state['program']}\n```"})
+        messages.append({"role": "user", "content": (
+            "Running your program failed. Return the complete fixed program; it must "
+            f"still end with deck.save(OUTPUT_PATH).\n\n=== ERROR ===\n{state['error']}")})
+        return {"messages": messages}
+
+    def finish(state: DeckState) -> DeckState:
+        warnings = list(state.get("warnings", []))
+        best = state.get("best") or {}
+        if not state.get("raw_deck"):       # the fix round's program failed
+            warnings.append("the fix round failed to run; the deck before it was used")
+        warnings += [f"layout: {p}" for p in best.get("problems", [])]
+        warnings += [f"style: {d}" for d in best.get("differences", [])]
+        out = Path(state["output_path"])
+        shutil.copyfile(best.get("deck") or state["good_deck"], out)
+        return {"final_deck": str(out), "warnings": warnings, "status": "done"}
+
+    def score(state: DeckState) -> DeckState:
+        try:
+            card = scorecard.score_deck(Path(state["final_deck"]), state.get("spec"),
+                                        state.get("style_target"))
+        except Exception as exc:            # a scoring bug must never cost the deck
+            log.warning("scorecard failed: %s", exc)
+            return {}
+        log.info("%s", scorecard.summary_line(card))
+        step(scorecard.summary_line(card))
+        return {"scorecard": card}
+
+    def fail(state: DeckState) -> DeckState:
+        log.error("no deck after %d attempt(s): %s", state.get("attempts", 0),
+                  state.get("error"))
+        return {"status": "failed"}
+
+    graph = StateGraph(DeckState)
+    for name, node in (("write_program", write_program), ("run_program", run_program),
+                       ("repair", repair), ("check_deck", check_deck),
+                       ("fix_deck", fix_deck), ("finish", finish), ("score", score),
+                       ("fail", fail)):
+        graph.add_node(name, node)
+    graph.add_edge(START, "write_program")
+    graph.add_edge("write_program", "run_program")
+    graph.add_conditional_edges("run_program", after_run,
+                                {"check_deck": "check_deck", "repair": "repair",
+                                 "finish": "finish", "fail": "fail"})
+    graph.add_conditional_edges("check_deck", after_check,
+                                {"fix_deck": "fix_deck", "finish": "finish"})
+    graph.add_edge("repair", "write_program")
+    graph.add_edge("fix_deck", "write_program")
+    graph.add_edge("finish", "score")
+    graph.add_edge("score", END)
+    graph.add_edge("fail", END)
+    return graph.compile()
