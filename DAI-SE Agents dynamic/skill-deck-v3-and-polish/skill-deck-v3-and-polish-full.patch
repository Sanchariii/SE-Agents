index 0000000..19b1785
--- /dev/null
+++ b/app/genai/deck_polish/reader.py
@@ -0,0 +1,203 @@
+"""Read a deck: what each shape is, where it sits and what it says.
+
+Everything here only reads. Positions are in inches, as the ppt skill and DeckBuilder
+use them, and every shape is referred to by its ``shape_id`` (unique on its slide), which
+is also how the model names a shape in an edit operation.
+"""
+from __future__ import annotations
+
+from pptx.enum.shapes import MSO_SHAPE_TYPE, PP_PLACEHOLDER
+
+from app.config.constants import DeckPolishConstants as C, SkillDeckConstants as SD
+
+EMU = 914400
+#: Shapes stamped by the template frame or an older branding component: never content.
+FURNITURE = (SD.WORDMARK_SHAPE_NAME, SD.BADGE_SHAPE_NAME, SD.LABEL_SHAPE_NAME,
+             *SD.FRAME_SHAPE_PREFIXES)
+
+Box = tuple[float, float, float, float]          # left, top, right, bottom (in)
+
+_TITLE_TYPES = (PP_PLACEHOLDER.TITLE, PP_PLACEHOLDER.CENTER_TITLE)
+_SUBTITLE_TYPES = (PP_PLACEHOLDER.SUBTITLE,)
+_FOOTER_TYPES = (PP_PLACEHOLDER.FOOTER, PP_PLACEHOLDER.SLIDE_NUMBER, PP_PLACEHOLDER.DATE)
+
+
+def inches(emu) -> float:
+    return (emu or 0) / EMU
+
+
+def has_box(shape) -> bool:
+    return shape.left is not None and shape.width is not None
+
+
+def box(shape) -> Box:
+    left, top = inches(shape.left), inches(shape.top)
+    return left, top, left + inches(shape.width), top + inches(shape.height)
+
+
+def overlap(a: Box, b: Box) -> float:
+    """Area (sq in) two boxes share."""
+    w = min(a[2], b[2]) - max(a[0], b[0])
+    h = min(a[3], b[3]) - max(a[1], b[1])
+    return w * h if w > 0 and h > 0 else 0.0
+
+
+def area(a: Box) -> float:
+    return max(a[2] - a[0], 0) * max(a[3] - a[1], 0)
+
+
+def contains(outer: Box, inner: Box, tol: float = 0.05) -> bool:
+    return (inner[0] >= outer[0] - tol and inner[1] >= outer[1] - tol
+            and inner[2] <= outer[2] + tol and inner[3] <= outer[3] + tol)
+
+
+def is_furniture(shape) -> bool:
+    return shape.name.startswith(FURNITURE)
+
+
+def text_of(shape) -> str:
+    if not getattr(shape, "has_text_frame", False):
+        return ""
+    return shape.text_frame.text.strip()
+
+
+def paragraphs(shape) -> list[str]:
+    """Non-empty paragraph texts of a text shape."""
+    if not getattr(shape, "has_text_frame", False):
+        return []
+    return [p.text.strip() for p in shape.text_frame.paragraphs if p.text.strip()]
+
+
+def kind(shape) -> str:
+    """One word for what the shape is: title, subtitle, body, picture, table, chart,
+    card, shape, textbox, line, group, footer or frame."""
+    if is_furniture(shape):
+        return "frame"
+    if shape.is_placeholder:
+        ph_type = shape.placeholder_format.type
+        if ph_type in _TITLE_TYPES:
+            return "title"
+        if ph_type in _SUBTITLE_TYPES:
+            return "subtitle"
+        if ph_type in _FOOTER_TYPES:
+            return "footer"
+        if ph_type == PP_PLACEHOLDER.PICTURE and not text_of(shape):
+            return "picture"
+    shape_type = shape.shape_type
+    if shape_type == MSO_SHAPE_TYPE.PICTURE or (shape.is_placeholder
+                                                and hasattr(shape, "image")):
+        return "picture"
+    if getattr(shape, "has_table", False):
+        return "table"
+    if getattr(shape, "has_chart", False):
+        return "chart"
+    if shape_type == MSO_SHAPE_TYPE.GROUP:
+        return "group"
+    if shape_type in (MSO_SHAPE_TYPE.LINE,) or shape.__class__.__name__ == "Connector":
+        return "line"
+    if shape.is_placeholder:
+        return "body"
+    if shape_type == MSO_SHAPE_TYPE.AUTO_SHAPE:
+        filled = False
+        try:
+            filled = shape.fill.type is not None and shape.fill.type != 5
+        except (AttributeError, TypeError, NotImplementedError):
+            pass
+        b = box(shape) if has_box(shape) else (0, 0, 0, 0)
+        if filled and min(b[2] - b[0], b[3] - b[1]) >= SD.LAYOUT_MIN_CARD_IN:
+            return "card"
+        return "shape"
+    if shape_type == MSO_SHAPE_TYPE.TEXT_BOX:
+        return "textbox"
+    return "shape"
+
+
+def run_sizes(shape) -> list[float]:
+    """Font sizes (pt) set on the shape's runs (or paragraphs) with text."""
+    sizes = []
+    if not getattr(shape, "has_text_frame", False):
+        return sizes
+    for paragraph in shape.text_frame.paragraphs:
+        for run in paragraph.runs:
+            if not run.text.strip():
+                continue
+            size = run.font.size or paragraph.font.size
+            if size is not None:
+                sizes.append(round(size.pt, 1))
+    return sizes
+
+
+def template_graphics(slide) -> list[Box]:
+    """Boxes of the graphics the slide's layout and master draw (bands, panels, frames).
+
+    A placeholder that sits on one is placed by the template's designer - e.g. column
+    titles printed on coloured bands - so nothing here moves it. Full-slide backgrounds
+    are left out: everything sits on those.
+    """
+    width = inches(slide.part.package.presentation_part.presentation.slide_width)
+    height = inches(slide.part.package.presentation_part.presentation.slide_height)
+    boxes = []
+    for owner in (slide.slide_layout, slide.slide_layout.slide_master):
+        for shape in owner.shapes:
+            if shape.is_placeholder or not has_box(shape):
+                continue
+            b = box(shape)
+            if area(b) < 0.5 * width * height and min(b[2] - b[0], b[3] - b[1]) > 0.2:
+                boxes.append(b)
+    return boxes
+
+
+def on_template_graphic(shape, graphics: list[Box]) -> bool:
+    """True when the shape sits wholly on a graphic its layout draws."""
+    return has_box(shape) and any(contains(g, box(shape)) for g in graphics)
+
+
+def set_box(shape, left: float, top: float, width: float, height: float) -> None:
+    """Set all four of a shape's coordinates (inches).
+
+    A placeholder that inherits its position has no geometry of its own; setting only
+    ``top`` would give it a zero width, so all four are always written.
+    """
+    shape.left, shape.top = int(left * EMU), int(top * EMU)
+    shape.width, shape.height = int(width * EMU), int(height * EMU)
+
+
+def find_shape(slide, shape_id: int):
+    """The shape with this id on the slide, or None."""
+    return next((s for s in slide.shapes if s.shape_id == shape_id), None)
+
+
+def describe_slide(slide, number: int) -> dict:
+    """The slide as compact JSON for the model: layout, and one entry per shape."""
+    shapes = []
+    graphics = template_graphics(slide)
+    for shape in slide.shapes:
+        if not has_box(shape):
+            continue
+        entry = {"id": shape.shape_id, "kind": kind(shape),
+                 "box": [round(v, 2) for v in (inches(shape.left), inches(shape.top),
+                                               inches(shape.width), inches(shape.height))]}
+        text = text_of(shape)
+        if text:
+            entry["text"] = text[:C.MAX_TEXT_CHARS]
+            entry["paragraphs"] = len(paragraphs(shape))
+        sizes = run_sizes(shape)
+        if sizes:
+            entry["pt"] = sorted(set(sizes))
+        if shape.is_placeholder:
+            entry["placeholder"] = True
+        if on_template_graphic(shape, graphics):
+            entry["fixed"] = True               # placed on a template graphic: keep it
+        shapes.append(entry)
+    notes = ""
+    if slide.has_notes_slide:
+        notes = slide.notes_slide.notes_text_frame.text.strip()
+    return {"slide": number, "layout": slide.slide_layout.name, "shapes": shapes,
+            **({"notes_chars": len(notes)} if notes else {})}
+
+
+def describe_deck(prs) -> dict:
+    """The whole deck for the model."""
+    return {"slide_size_in": [round(inches(prs.slide_width), 2),
+                              round(inches(prs.slide_height), 2)],
+            "slides": [describe_slide(s, n) for n, s in enumerate(prs.slides, 1)]}
diff --git a/app/genai/deck_polish/rules.py b/app/genai/deck_polish/rules.py
new file mode 100644
index 0000000..32d2710
--- /dev/null
+++ b/app/genai/deck_polish/rules.py
@@ -0,0 +1,215 @@
+"""Fixes made by code, with no model call - everything the LOW level does.
+
+Each rule takes the open deck and the issues ``checks.find_issues`` found, changes only
+what those issues point at, and returns one plain sentence per change for the chat.
+
+LOW keeps every slide's arrangement as the engine built it: it removes a duplicated
+label, pulls a shape back onto the slide, lifts text off the type-scale floor, swaps an
+off-brand colour for the nearest brand colour and fixes UK spelling. MEDIUM and HIGH
+also re-arrange: they lift column headings that sit under their columns and raise small
+component text to a comfortable reading size where it still fits its box.
+"""
+from __future__ import annotations
+
+from pptx.dml.color import RGBColor
+from pptx.util import Pt
+
+from app.config.constants import DeckPolishConstants as C
+from app.genai.deck_polish import checks, reader, spelling
+
+
+
+def _by_code(issues, code):
+    return [i for i in issues if i.code == code]
+
+
+def _slide(prs, number):
+    return prs.slides[number - 1]
+
+
+def _text_frames(slide):
+    """Every text frame on the slide: shapes, table cells and the speaker notes."""
+    for shape in slide.shapes:
+        if getattr(shape, "has_text_frame", False):
+            yield shape.text_frame
+        if getattr(shape, "has_table", False):
+            for row in shape.table.rows:
+                for cell in row.cells:
+                    yield cell.text_frame
+    if slide.has_notes_slide:
+        yield slide.notes_slide.notes_text_frame
+
+
+# --- LOW --------------------------------------------------------------------------- #
+def dedupe_labels(prs, issues) -> list[str]:
+    changes = []
+    for issue in _by_code(issues, "duplicate_label"):
+        slide = _slide(prs, issue.slide)
+        removed = [s for s in slide.shapes
+                   if s.name in (C.FRAME_LABEL_NAME, C.FRAME_SYMBOL_NAME)]
+        for shape in removed:
+            shape._element.getparent().remove(shape._element)
+        if removed:
+            changes.append(f"slide {issue.slide}: removed the stamped classification "
+                           "label that sat on top of the one the layout already prints")
+    return changes
+
+
+def dedupe_numbers(prs, issues) -> list[str]:
+    slides = []
+    for issue in _by_code(issues, "duplicate_number"):
+        slide = _slide(prs, issue.slide)
+        for shape in [s for s in slide.shapes if s.name == C.FRAME_NUMBER_NAME]:
+            shape._element.getparent().remove(shape._element)
+            slides.append(issue.slide)
+    if not slides:
+        return []
+    return [f"removed the stamped slide number on {len(slides)} slide(s); the template "
+            "already prints one"]
+
+
+def onto_slide(prs, issues) -> list[str]:
+    width, height = prs.slide_width, prs.slide_height
+    changes = []
+    for issue in _by_code(issues, "off_slide"):
+        slide = _slide(prs, issue.slide)
+        for shape_id in issue.shapes:
+            shape = reader.find_shape(slide, shape_id)
+            if shape is None or shape.width > width or shape.height > height:
+                continue
+            shape.left = int(min(max(shape.left, 0), width - shape.width))
+            shape.top = int(min(max(shape.top, 0), height - shape.height))
+            changes.append(f"slide {issue.slide}: moved shape {shape_id} back onto the slide")
+    return changes
+
+
+def _set_min_size(shape, minimum: float, placeholders: bool) -> int:
+    """Raise every sized run below ``minimum`` pt to it. Returns runs changed."""
+    if not getattr(shape, "has_text_frame", False):
+        return 0
+    if shape.is_placeholder and not placeholders:
+        return 0
+    changed = 0
+    for paragraph in shape.text_frame.paragraphs:
+        if paragraph.font.size is not None and paragraph.font.size.pt < minimum:
+            paragraph.font.size = Pt(minimum)
+            changed += 1
+        for run in paragraph.runs:
+            if run.font.size is not None and run.font.size.pt < minimum:
+                run.font.size = Pt(minimum)
+                changed += 1
+    return changed
+
+
+def floor_text(prs, issues) -> list[str]:
+    changes = []
+    for issue in _by_code(issues, "tiny_text"):
+        slide = _slide(prs, issue.slide)
+        runs = sum(_set_min_size(reader.find_shape(slide, i), C.FLOOR_PT, True)
+                   for i in issue.shapes if reader.find_shape(slide, i) is not None)
+        if runs:
+            changes.append(f"slide {issue.slide}: raised {runs} text run(s) to the "
+                           f"{C.FLOOR_PT} pt floor")
+    return changes
+
+
+def _recolor(shape, old: str, new: str) -> int:
+    changed = 0
+    if checks.fill_color(shape) == old:
+        shape.fill.fore_color.rgb = RGBColor.from_string(new)
+        changed += 1
+    if getattr(shape, "has_text_frame", False):
+        for paragraph in shape.text_frame.paragraphs:
+            for run in paragraph.runs:
+                if checks.run_color(run) == old:
+                    run.font.color.rgb = RGBColor.from_string(new)
+                    changed += 1
+    return changed
+
+
+def brand_colors(prs, issues) -> list[str]:
+    changes = []
+    for issue in _by_code(issues, "off_palette"):
+        old = issue.data["color"]
+        new = checks.nearest_brand(old)
+        slide = _slide(prs, issue.slide)
+        count = sum(_recolor(s, old, new) for s in slide.shapes if s.shape_id in issue.shapes)
+        if count:
+            changes.append(f"slide {issue.slide}: changed colour {old} to the brand "
+                           f"colour {new}")
+    return changes
+
+
+def us_spelling(prs, issues) -> list[str]:
+    changes = []
+    for issue in _by_code(issues, "uk_spelling"):
+        fixed = []
+        for frame in _text_frames(_slide(prs, issue.slide)):
+            for paragraph in frame.paragraphs:
+                for run in paragraph.runs:
+                    new = spelling.to_us(run.text)
+                    if new != run.text:
+                        fixed += spelling.uk_words(run.text)
+                        run.text = new
+        if fixed:
+            changes.append(f"slide {issue.slide}: US spelling for "
+                           + ", ".join(dict.fromkeys(fixed)))
+    return changes
+
+
+# --- MEDIUM and HIGH --------------------------------------------------------------- #
+def readable_text(prs, issues) -> list[str]:
+    """Raise small component text to READ_PT where the box still holds it."""
+    changes = []
+    for issue in _by_code(issues, "small_text"):
+        slide = _slide(prs, issue.slide)
+        raised = 0
+        for shape_id in issue.shapes:
+            shape = reader.find_shape(slide, shape_id)
+            if shape is None:
+                continue
+            before = [(item, item.font.size) for p in shape.text_frame.paragraphs
+                      for item in (p, *p.runs)]
+            if not _set_min_size(shape, C.READ_PT, False):
+                continue
+            needed = checks._needed(shape)                  # noqa: SLF001
+            if needed and needed > reader.inches(shape.height) + 0.05:
+                for item, size in before:                   # does not fit: put it back
+                    item.font.size = size
+                continue
+            raised += 1
+        if raised:
+            changes.append(f"slide {issue.slide}: raised small text to {C.READ_PT} pt in "
+                           f"{raised} box(es)")
+    return changes
+
+
+def lift_headings(prs, issues) -> list[str]:
+    """Move column headings from under their columns to above them."""
+    changes = []
+    for issue in _by_code(issues, "heading_below"):
+        slide = _slide(prs, issue.slide)
+        pairs = checks.headings_below(slide)
+        for head, block in pairs:
+            hl, ht, hr, hb = reader.box(head)
+            bl, bt, br, bb = reader.box(block)
+            shift = (hb - ht) + C.HEADING_GAP_IN
+            reader.set_box(head, hl, bt, hr - hl, hb - ht)
+            reader.set_box(block, bl, bt + shift, br - bl, max(bb - bt - shift, 0.5))
+        if pairs:
+            changes.append(f"slide {issue.slide}: moved {len(pairs)} column heading(s) "
+                           "above their columns")
+    return changes
+
+
+LOW_RULES = (dedupe_labels, dedupe_numbers, onto_slide, floor_text, brand_colors, us_spelling)
+ARRANGE_RULES = (lift_headings, readable_text)
+
+
+def apply(prs, issues, level: str) -> list[str]:
+    """Run every rule for this level. Returns the change sentences."""
+    rules = LOW_RULES + (ARRANGE_RULES if level in C.ARRANGE_RULES_FROM else ())
+    changes = []
+    for rule in rules:
+        changes += rule(prs, issues)
+    return changes
