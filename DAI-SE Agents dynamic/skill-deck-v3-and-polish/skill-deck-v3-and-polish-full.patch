+# --- the model's answer ---------------------------------------------------------- #
+def test_program_read_from_fenced_reply():
+    reply = {"content": [{"type": "text", "text": f"Here:\n```python\n{GOOD_PROGRAM}```"}]}
+    assert "deck = WholeDeck()" in extract_program(reply)
