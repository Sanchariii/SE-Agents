+@contextmanager
+def using_template(path: Path | str | None):
+    """Build on ``path`` instead of the brand template inside this block.
+
+    Args:
+        path: A prepared reference deck, or None to leave the brand template in place.
+    """
+    if path is None:
+        yield
+        return
