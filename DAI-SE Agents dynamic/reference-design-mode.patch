+    try:
+        yield
+    finally:
+        _TEMPLATE_OVERRIDE.reset(token)
+
+
+def template_override() -> Path | None:
+    """The reference deck this build uses instead of the brand template, if any."""
+    return _TEMPLATE_OVERRIDE.get()
