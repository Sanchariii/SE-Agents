# Copy to dev.env / qa.env / prod.env and fill in. NEVER commit a filled-in file.
# In hosted mode these same keys come from Azure Key Vault as one JSON blob,
# with UPPER-HYPHEN names normalised to UPPER_SNAKE on load.
#
# Secrets and per-deployment values only. Static constants (limits, chunk sizes,
# file extensions, container names, agent budgets) live in app/config/constants.py.

LOG_LEVEL=INFO

# --- HTTP / CORS --------------------------------------------------------------
# Comma-separated exact origins. Do not use "*": credentials are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- TLS ----------------------------------------------------------------------
TLS_CA_BUNDLE=
TLS_VERIFY=true

# --- Postgres -----------------------------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USERNAME=postgres
PG_PASSWORD=
PG_DATABASE=se_agent
PG_SSLMODE=

# --- Redis --------------------------------------------------------------------
REDIS_URI=redis://127.0.0.1:6379/0

# --- Azure OpenAI -------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper

# --- Azure AI Search ----------------------------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=training-docs

# --- Azure Blob Storage -------------------------------------------------------
# Leave empty to fall back to ./.local_storage (local development only).
BLOB_CONNECTION_STR=

# --- Azure Document Intelligence ----------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
USE_DOC_INTELLIGENCE=true

# --- Auth (Entra ID SSO) ------------------------------------------------------
# RS256 keys are read from app/config/private and app/config/public.
JWT_REQUIRED=true
# Tenant + app registration the front end signs in against. Both are required for
# the id token to be cryptographically verified.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_VERIFY_ID_TOKEN=true

# --- Transcription ------------------------------------------------------------
WHISPER_BACKEND=azure
WHISPER_LOCAL_MODEL=base

# --- Max mode (render-and-review of HIGH-creativity slides) --------------------
SLIDE_MAX_MODE_ENABLED=true
# LibreOffice binary; empty autodetects (PATH, then the Windows install folder).
SOFFICE_PATH=
